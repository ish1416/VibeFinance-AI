{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibefinance.ai/schemas/analysis.schema.json",
  "title": "VibeFinance Analysis (synthesis output)",
  "description": "The single object every screen renders from. In DEMO mode the frontend serves a committed fixture with exactly this shape, so the UI is provably independent of backend availability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "symbol", "generated_at", "snapshot_id", "profile", "agents", "verdict", "evidence_ledger", "verification_summary", "portfolio_impact", "compliance", "degraded", "metrics"],
  "properties": {
    "run_id": { "type": "string" },
    "symbol": { "type": "string" },
    "generated_at": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weights"],
      "properties": {
        "id": { "enum": ["CONSERVATIVE", "BALANCED", "AGGRESSIVE"] },
        "name": { "type": "string" },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["technical", "fundamental", "sentiment"],
          "properties": {
            "technical": { "type": "number", "minimum": 0, "maximum": 1 },
            "fundamental": { "type": "number", "minimum": 0, "maximum": 1 },
            "sentiment": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "stop_loss_percent": { "type": "number" },
        "target_horizon": { "type": "string" },
        "per_equity_cap": { "type": "number" },
        "sector_cap": { "type": "number" },
        "max_trade_inr": { "type": "number" }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "agent.schema.json" }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "badge", "score", "confidence"],
      "properties": {
        "label": { "type": "string" },
        "badge": { "enum": ["STRONG_BUY", "BUY", "HOLD", "SELL", "WARNING", "NO_ACTION"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "entry": { "type": ["number", "null"] },
        "target": { "type": ["number", "null"] },
        "stop_loss": { "type": ["number", "null"] },
        "horizon": { "type": ["string", "null"] },
        "position_size_inr": { "type": ["number", "null"] }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "citation", "verified"],
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "citation": { "type": "string" },
          "verified": { "type": "boolean" },
          "method": { "type": ["string", "null"] },
          "agent_id": { "type": ["string", "null"] }
        }
      }
    },
    "verification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_total", "claims_verified", "unsupported", "coverage_pct"],
      "properties": {
        "claims_total": { "type": "integer", "minimum": 0 },
        "claims_verified": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "suppressed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "conflict": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["detected"],
      "properties": {
        "detected": { "type": "boolean" },
        "max_polarity_gap": { "type": ["number", "null"] },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["a", "b", "gap"],
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" },
              "gap": { "type": "number" }
            }
          }
        },
        "policy_applied": { "type": ["string", "null"] },
        "rejected_verdicts": { "type": "array", "items": { "type": "string" } },
        "flip_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "portfolio_impact": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["breach", "suitability"],
      "properties": {
        "hhi_before": { "type": "number" },
        "hhi_after": { "type": "number" },
        "sector_before": { "type": "number" },
        "sector_after": { "type": "number" },
        "sector_cap": { "type": "number" },
        "breach": { "type": "boolean" },
        "breach_reason": { "type": ["string", "null"] },
        "stress_test": { "type": "object" },
        "alternative": { "type": ["string", "null"] },
        "suitability": { "enum": ["APPROVED", "WARN_CONCENTRATION", "BLOCKED_BY_SECTOR_CAP", "BLOCKED_BY_TRADE_CAP", "BLOCKED_BY_INSTRUMENT"] }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibited_phrases_blocked", "classification"],
      "properties": {
        "prohibited_phrases_blocked": { "type": "integer", "minimum": 0 },
        "blocked_phrases": { "type": "array", "items": { "type": "string" } },
        "classification": { "type": "string" },
        "disclosure": { "type": "string" }
      }
    },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "sources", "mitigations"],
      "properties": {
        "active": { "type": "boolean" },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "enum": ["LIVE", "DELAYED", "CACHED", "SIMULATED", "UNAVAILABLE"]
          }
        },
        "source_meta": { "type": "object" },
        "mitigations": { "type": "array", "items": { "type": "string" } },
        "fallback_mode": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "risk_concentration"],
      "properties": {
        "latency_ms": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "total": { "type": "number" },
            "p50": { "type": ["number", "null"] },
            "p95": { "type": ["number", "null"] },
            "per_agent": { "type": "object" }
          }
        },
        "cost_usd": { "type": ["number", "null"] },
        "signal": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"] },
        "risk_concentration": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "hhi": { "type": "number" },
            "label": { "type": "string" }
          }
        },
        "calibration": { "type": ["object", "null"] },
        "forward_return_check": { "type": ["object", "null"] },
        "retrieval": { "type": ["object", "null"] }
      }
    }
  }
}
