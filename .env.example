# VibeFinance AI — environment template. Copy to .env and fill in. NEVER commit .env.

# ── LLM (agents) ─────────────────────────────────────────────────────────────
# Primary: Google Gemini (free tier, native JSON-schema-constrained output)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash
# Fallback: Groq (used automatically when Gemini times out or is rate-limited)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2
# 1 = replay committed cached LLM responses only (offline-safe demo). 0 = live calls.
LLM_CACHE_ONLY=0

# ── Vector store (optional) ──────────────────────────────────────────────────
# Leave blank to use the committed local index (NumPy matrix + BM25).
# MongoDB Atlas M0 free cluster gives a managed vector index; paste the connection string.
MONGODB_URI=
MONGODB_DB=vibefinance_ai
MONGODB_VECTOR_INDEX=vector_index

# ── Market data (optional live upgrade) ──────────────────────────────────────
# Upstox read-only Analytics Token (instrument-agnostic quote + historical candles).
# Without it, prices come from the committed snapshot artifacts and are labelled DELAYED.
UPSTOX_ACCESS_TOKEN=

# ── Service ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/vibefinance.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (Vite exposes only VITE_* to the browser) ───────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
# off = render from committed fixtures with no backend (guaranteed demo path)
VITE_API_MODE=on
